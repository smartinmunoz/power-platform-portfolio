
{
  "name": "FL02-Excel-Processing-Demo",
  "description": "Excel processing, export generation, and related SharePoint record creation",
  "version": "1.0",
  "type": "demonstration",
  "trigger": {
    "operation": "When a file is created or modified (properties only)",
    "condition": "FileStatus = Validated",
    "type": "SharePoint"
  },
  "sharePoint": {
    "sourceLibrary": "Validation Library",
    "destinationList": "Processed Records List",
    "temporaryLibrary": "Temporary Files Library",
    "site": "https://contoso.sharepoint.com/sites/DemoSite"
  },
 
"variables": [
  {
    "initialValue": 0,
    "name": "SharePointErrors",
    "type": "integer"
  },
  {
    "initialValue": 0,
    "name": "RecordsWithErrors",
    "type": "integer"
  },
  {
    "initialValue": 0,
    "name": "LastPrimaryRecordId",
    "type": "integer"
  },
  {
    "initialValue": [],
    "name": "ErrorDetails",
    "type": "array"
  },
  {
    "initialValue": 0,
    "name": "RecordsCreated",
    "type": "integer"
  }
],

  "actions": [
    {
      "operation": "Break permission inheritance",
      "name": "BreakFilePermissionInheritance"
    },
    {
      "operation": "Grant Read permission",
      "group": "Members",
      "name": "GrantMembersReadAccess"
    },
    {
      "operation": "Grant Read permission",
      "group": "Owners",
      "name": "GrantOwnersReadAccess"
    },
 
{
  "operation": "Update SharePoint file properties",
  "name": "MarkFileAsProcessing",
  "status": "Processing",
  "previousStatus": "Validated",
  "note": "Set the source file status to Processing before starting Excel operations. This prevents the Validated trigger condition from matching subsequent file modifications."
},
    {
      "operation": "Condition",
      "ifFalse": [],
      "ifTrue": [
        "Get validated Excel file",
        "Create temporary working copy",
        "Run process-records.ts",
        "Check Office Script result",
        "Get Excel export template",
        "Create export workbook",
        "Run populate-export-template.ts",
        "Process extracted records sequentially"
      ],
      "name": "ValidateProcessingCondition"
    },
    {
      "recordTypes": {
        "associated": "B",
        "primary": "T"
      },
      "concurrency": 1,
      "name": "ProcessExcelRecords",
      "primaryRecord": [
        "Reset last primary record ID",
        "Create primary SharePoint item",
        "Increment created records count on success",
        "Save created primary item ID",
        "Track and record creation errors"
      ],
      "familyIdentifier": "concat(SourceFileId, '-', FamilyId)",
     
"associatedRecord": [
  "Validate associated record",
  "Verify that LastPrimaryRecordId is greater than 0",
  "If no valid primary record exists, skip associated record creation and append a diagnostic entry",
  "If a valid primary record exists, create associated SharePoint item with ParentRecordId set to LastPrimaryRecordId",
  "Increment created records count on success",
  "Track and append SharePoint creation errors"
]
],
      "operation": "Apply to each"
    },
  {
  "operation": "Compose",
  "details": [
    "Count records extracted from Excel",
    "Count failed SharePoint record creation operations",
    "Set RecordsWithErrors equal to SharePointErrors",
    "Combine SharePoint creation error details"
    ],
    "name": "CalculateFinalDiagnostics"
  },

    {
      "operation": "Compose JSON",
      "properties": [
        "ProcessingReferenceId",
        "RecordsCreated",
        "SharePointErrors",
        "ErrorDetails"
      ],
      "name": "BuildProcessingSummary"
    },
    {
      "operation": "Run child flow",
      "childFlow": "FL04-Processing-Logs-Demo",
      "output": "Id_Log",
      "name": "ExecuteFL04",
      "inputCount": 8,
      "inputMappings": {
        "ProcessingReferenceId": "CurrentProcessingReferenceId",
        "SourceFileId": "TriggerFileId",
        "SourceFileName": "TriggerFileName",
        "RecordsRead": "CalculatedRecordsRead",
        "RecordsCreated": "RecordsCreated",
        "RecordsWithErrors": "SharePointErrors",
        "ErrorDetails": "ConsolidatedErrorDetails",
        "ExecutionId": "CurrentFlowExecutionId"

      }
    },
    {
      "operation": "Update SharePoint file properties",
      "name": "MarkFileAsProcessed",
      "status": "Processed",
      "previousStatus": "Processing",
      "runAfter": {
        "ExecuteFL04": [
          "Succeeded"
        ]
      },
      "condition": "Main processing completed successfully AND SharePointErrors = 0",

      "note": "Mark the source document as Processed only after successful completion of the processing workflow and FL04 logging."
    },
    {
      "operation": "Update SharePoint file properties",
      "name": "MarkFileAsError",
      "status": "Error",
      "previousStatus": "Processing",
      "runAfter": {
        "MarkFileAsProcessed": [
          "Skipped",
          "Failed",
          "TimedOut"
        ]
      },
      "condition": "Main processing failed OR SharePointErrors > 0 OR FL04 logging failed",
      "note": "Mark the source document as Error when processing cannot complete successfully, when SharePoint record creation errors are detected, or when execution logging fails. The error branch must also handle failures that prevent FL04 from running."
    }
  ],


  "officeScripts": [
    "process-records.ts",
    "populate-export-template.ts"
  ],
  "relatedFlows": [
    {
      "purpose": "Processing logs and error tracking",
      "relationship": "Child flow invoked by FL02",
      "id": "FL04"
    },
    {
      "purpose": "Scheduled cleanup of temporary Excel files",
      "relationship": "Separate maintenance workflow",
      "id": "FL03"
    }
  ],
  "implementationStatus": "Conceptual demonstration - Not an importable Power Automate flow"
}
