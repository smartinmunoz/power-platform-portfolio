{
  "name": "FL01-Recepcion-Archivos-Demo",
  "description": "Recepcion y distribucion de archivos Excel en SharePoint",
  "version": "1.0",
  "type": "demonstration",
  "trigger": {
    "type": "SharePoint",
    "event": "When an item is created",
    "site": "https://contoso.sharepoint.com/sites/DemoSite",
    "list": "SolicitudesDemo"
  },
  "actions": [
    {
      "name": "BreakItemPermissionInheritance",
      "type": "SharePoint",
      "operation": "Break permission inheritance"
    },
    {
      "name": "GrantItemAccess",
      "type": "SharePoint",
      "operation": "Grant access to item"
    },
    {
      "name": "AssignItemReadGroupA",
      "type": "SharePoint",
      "operation": "Assign read access",
      "group": "GroupA-Demo"
    },
    {
      "name": "AssignItemReadGroupB",
      "type": "SharePoint",
      "operation": "Assign read access",
      "group": "GroupB-Demo"
    },
    {
      "name": "GetAttachments",
      "type": "SharePoint",
      "operation": "Get attachments"
    },
    {
      "name": "GetAttachmentContent",
      "type": "SharePoint",
      "operation": "Get attachment content"
    },
    {
      "name": "CreateOriginalFile",
      "type": "SharePoint",
      "operation": "Create file",
      "destination": "DocumentosEntradaDemo"
    },
    {
      "name": "BreakFilePermissionInheritance",
      "type": "SharePoint",
      "operation": "Break permission inheritance"
    },
    {
      "name": "AssignFileReadGroupA",
      "type": "SharePoint",
      "operation": "Assign read access",
      "group": "GroupA-Demo"
    },
    {
      "name": "AssignFileReadGroupB",
      "type": "SharePoint",
      "operation": "Assign read access",
      "group": "GroupB-Demo"
    },
    {
      "name": "UpdateOriginalFileProperties",
      "type": "SharePoint",
      "operation": "Update file properties"
    },
    {
      "name": "GetOriginalFileProperties",
      "type": "SharePoint",
      "operation": "Get file properties"
    },
    {
      "name": "UpdateRequestStatus",
      "type": "SharePoint",
      "operation": "Update item"
    },
    {
      "name": "UpdateOriginalFileResults",
      "type": "SharePoint",
      "operation": "Update file properties"
    },
    {
      "name": "CreateValidationFile",
      "type": "SharePoint",
      "operation": "Create file",
      "destination": "DocumentosValidacionDemo"
    },
    {
      "name": "UpdateValidationFileProperties",
      "type": "SharePoint",
      "operation": "Update file properties"
    }
  ],
  "attachmentHandling": {
    "condition": "HasAttachments equals true",
    "ifFalse": "End without processing",
    "ifTrue": {
      "loop": "Apply to each attachment",
      "filter": "Only .xlsx files",
      "operations": [
        "Get attachment content",
        "Create file in DocumentosEntradaDemo",
        "Create file in DocumentosValidacionDemo"
      ]
    }
  },
  "permissions": {
    "requestItem": {
      "inheritance": "Broken",
      "access": "Restricted",
      "groups": [
        {
          "name": "IntegrantesDemo",
          "permission": "Read"
        },
        {
          "name": "PropietariosDemo",
          "permission": "Read"
        },
        {
          "name": "ItemCreator",
          "permission": "Read"
        }
      ]
    },
    "originalFile": {
      "library": "DocumentosEntradaDemo",
      "inheritance": "Broken",
      "access": "Restricted",
      "groups": [
        {
          "name": "IntegrantesDemo",
          "permission": "Read"
        },
        {
          "name": "PropietariosDemo",
          "permission": "Read"
        }
      ]
    },
    "validationFile": {
      "library": "DocumentosValidacionDemo",
      "access": "Restricted",
      "groups": [
        {
          "name": "IntegrantesDemo",
          "permission": "Edit"
        },
        {
          "name": "PropietariosDemo",
          "permission": "Edit"
        }
      ]
    }
  },
  "documentMetadata": {
    "SolicitudID": "ID del elemento de SolicitudesDemo",
    "NombreArchivo": "Nombre original del adjunto",
    "EstadoValidacion": "Pendiente",
    "FechaRecepcion": "Fecha de creacion de la solicitud",
    "Origen": "SolicitudesDemo"
  }
}

